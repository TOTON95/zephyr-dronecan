config DRONECAN
	bool "DroneCAN support"
	depends on CAN && DT_HAS_ZEPHYR_DRONECAN_ENABLED
	help
	 Enables the DroneCAN (libcanard) support.

if DRONECAN

module = DRONECAN
module-str = dronecan
source "subsys/logging/Kconfig.template.log_config"

menu "Protocol"

config DRONECAN_NODE_TABLE
	bool "Node discovery table"
	help
	  Track nodes seen on the bus, this is built from received NodeStatus msgs.

config DRONECAN_DNIA_SERVER
	bool "Dynamic Node ID allocation server"
	select DRONECAN_NODE_TABLE
	help
	  Act as the DNIA allocator (like a flight controller).

config DRONECAN_DNIA_CLIENT
	bool "Dynamic Node ID allocation client"
	select HWINFO
	help
	  Request a node ID from an allocator, using the hardware unique ID (like a peripheral).

# TODO
